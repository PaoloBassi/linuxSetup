/* Catppuccin Mocha - summer-day-and-night style adaptation */

* {
    bg:         #1e1e2e;
    fg:         #cdd6f4;
    green:      #a6e3a1;
    green-dark: #4a8f55;
    crust:      #11111b;

    background-color:   transparent;
    text-color:         @fg;
    font:               "Iosevka Nerd Font 13";
}

window {
    background-color:   @fg;
    text-color:         @bg;
    border-radius:      15px;
    border:             0 0 5px 0;
    border-color:       #a6adc8;
    width:              35%;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
    spacing:            0px;
}

inputbar {
    background-color:   @green;
    text-color:         @bg;
    border-radius:      10px;
    border:             0 0 5px 0;
    border-color:       @green-dark;
    margin:             15px;
    padding:            10px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         @bg;
    padding:            0 6px 0 0;
}

entry {
    background-color:   transparent;
    text-color:         @bg;
    placeholder-color:  rgba(30,30,46,0.5);
    placeholder:        "Search...";
}

listview {
    background-color:   transparent;
    margin:             0 20px 20px 20px;
    spacing:            4px;
    scrollbar:          false;
    lines:              8;
    columns:            1;
}

element {
    background-color:   transparent;
    text-color:         @bg;
    border-radius:      10px;
    padding:            10px 15px;
    border:             0;
    orientation:        horizontal;
    children:           [ element-icon, element-text ];
}

element.selected {
    background-color:   @bg;
    text-color:         @fg;
    border:             0 0 5px 0;
    border-color:       @crust;
}

element-icon {
    background-color:   transparent;
    size:               40px;
    margin:             0 10px 0 0;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}
